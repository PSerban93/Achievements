{
  "name": "Achievements",
  "version": "1.2.9-beta.4",
  "description": "Achievements",
  "author": "JokerVerse",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:xbox-pc": "node tests/xbox-pc.test.js",
    "test:uplay-mapping": "node tests/uplay-mapping-refresh.test.js",
    "test:screenshot-paths": "node tests/screenshot-paths.test.js",
    "test:record-paths": "node tests/record-paths.test.js",
    "test:achievement-recorder": "node tests/achievement-recorder.test.js",
    "build:recorder": "cargo build --release --locked --manifest-path native/achievement-recorder/Cargo.toml",
    "copy:recorder": "node -e \"require('fs').copyFileSync('native/achievement-recorder/target/release/achievements-recorder.exe','utils/native/achievements-recorder.exe')\"",
    "verify:recorder": "node -e \"const fs=require('fs');const crypto=require('crypto');const p='utils/native/achievements-recorder.exe';const h=crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex').toUpperCase();console.log('achievement-recorder SHA256:',h)\"",
    "verify:process-tree": "node build/run-electron-script.js build/verify-windows-process-tree.js",
    "verify:san-runtime": "node build/verify-san-runtime.js",
    "prepare:process-tree": "npm run verify:process-tree",
    "prepare:recorder": "npm run build:recorder && npm run copy:recorder && npm run verify:recorder",
    "pack": "npm run prepare:recorder && npm run prepare:process-tree && npm run verify:san-runtime && electron-builder --dir",
    "dl-browsers": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 node ./node_modules/playwright-core/cli.js install chromium chromium-headless-shell",
    "dist": "npm run prepare:recorder && npm run dl-browsers && npm run prepare:process-tree && npm run verify:san-runtime && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.achievements.app",
    "productName": "Achievements",
    "copyright": "Copyright © 2025 JokerVerse",
    "npmRebuild": false,
    "asarUnpack": [
      "utils/**",
      "utils/pslist-wrapper.mjs",
      "**/node_modules/@vscode/windows-process-tree/**",
      "**/node_modules/screenshot-desktop/**",
      "**/node_modules/playwright/**",
      "**/node_modules/playwright-core/**",
      "**/node_modules/**/.local-browsers/**"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "icon.ico",
      "main.js",
      "preload.js",
      "index.html",
      "san-notification.html",
      "overlay.html",
      "progress.html",
      "playtime.html",
      "utils/playtime-log-watcher.js",
      "style.css",
      "tray-menu.html",
      "tray-menu.js",
      "tray-menu.css",
      "sounds/**/*",
      "presets/**/*",
      "utils/**/*",
      "utils/pslist-wrapper.mjs",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "sounds",
        "to": "sounds"
      },
      {
        "from": "presets",
        "to": "presets"
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "tools/schema_parse.zip",
        "to": "tools/schema_parse.zip"
      },
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "playwright-browsers"
      }
    ],
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Achievements"
    },
    "afterPack": "build/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "PSerban93",
        "repo": "Achievements"
      }
    ]
  },
  "dependencies": {
    "@vscode/windows-process-tree": ">=0.8.0",
    "@xboxreplay/xboxlive-auth": "^5.1.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.19.0",
    "cheerio": "^1.1.2",
    "chokidar": "5.0.0",
    "crc-32": "^1.2.2",
    "electron-updater": "^6.8.3",
    "ini": "6.0.0",
    "jsdom": "29.1.1",
    "koffi": "^3.1.5",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "ps-list": "9.0.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "screenshot-desktop": "^1.15.6",
    "uiohook-napi": "1.5.5",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "electron": "43.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "10.8.1",
    "rcedit": "^5.0.2"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "temp": {
      "rimraf": "^5.0.10"
    },
    "glob": {
      "minimatch": ">=10.2.1"
    }
  },
  "allowScripts": {
    "electron-winstaller": true,
    "electron": true,
    "koffi": true,
    "@vscode/windows-process-tree": true,
    "uiohook-napi": true
  }
}
